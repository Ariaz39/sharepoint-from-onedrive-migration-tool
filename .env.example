# ============================================================
# SharePoint Migration Environment Variables - EXAMPLE
# ============================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Keep the .env file secure and do not commit to version control

# SharePoint URLs
MY_URL=https://your-tenant-my.sharepoint.com/personal
DESTINATION_SITE_URL=https://your-tenant.sharepoint.com/sites/YourSite
DESTINATION_LIBRARY=your-library-name

# Authentication
ADMIN_ACCOUNT=admin@your-domain.com
CLIENT_ID=your-client-id-here
TENANT=your-tenant.onmicrosoft.com

# Certificate (file should be in same directory as script)
CERT_FILENAME=YourCertificate.pfx
CERT_PASSWORD=your-certificate-password

# Exclusions
# System folders that will be skipped during migration (comma-separated)
EXCLUDED_FOLDERS=Archivos de Microsoft Copilot Chat,Attachments,Forms,Notebook,Apps,_vti_cnf,Archivos de chat de Microsoft Teams,Documentos de Microsoft Teams,Grabaciones

# Users to migrate (comma-separated)
# You can migrate multiple users in a single run by separating their emails with commas
USERS=user1@your-domain.com
# USERS=user1@your-domain.com,user2@your-domain.com,user3@your-domain.com

# Performance Settings
THROTTLE_LIMIT=10          # Simultaneous threads (safe to avoid throttling)
BATCH_SIZE=500            # Batch size for memory cleanup
MAX_RETRIES=3             # Maximum retries per file
RETRY_DELAY_429=5         # Base delay in seconds for 429 errors (multiplied by retry count)
RETRY_DELAY_DEFAULT=2     # Delay in seconds for other errors
PAGE_SIZE=1000            # Page size for SharePoint queries
LOG_DIRECTORY=Logs        # Directory for log files